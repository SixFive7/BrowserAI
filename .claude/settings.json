{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*upstream-review.json)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/upstream-review-gate.ps1",
            "timeout": 15,
            "statusMessage": "Upstream-review gate"
          },
          {
            "type": "command",
            "if": "Write(*upstream-review.json)",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .claude/hooks/upstream-review-gate.ps1",
            "timeout": 15,
            "statusMessage": "Upstream-review gate"
          }
        ]
      }
    ]
  }
}
