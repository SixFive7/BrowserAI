<!--
  THE ONE EXECUTABLE'S MANIFEST SINCE 2026-10-08, D7 a. Until that day the
  server and the configuration app each carried one, and this is the two
  merged: the app's common controls and per-monitor awareness, because the one
  file now opens the folder picker the app opened, and the server's reasons for
  the long paths and for asInvoker, which were the app's as well.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <assemblyIdentity version="1.0.0.0" name="BrowserAI.app" />

  <!--
    ⚠️ THE ONE ENTRY WITHOUT WHICH THE CONFIGURATION APP HAD NO WINDOW AT ALL.

    TaskDialogIndirect lives in the version 6 comctl32, which is side-by-side
    and is NOT the one a process gets by default: without this dependency the
    loader binds version 5, the export is absent, and the call fails at run time
    with no compile-time signal whatever. It is the classic failure of this
    whole approach, and it presents as "the app starts and nothing happens".

    CORRECTED 2026-10-03 (previously as written above): the task dialog is
    deleted with the configuration window. The dependency stays for the folder
    picker the browser tab asks the coordinator to open, whose controls are drawn
    with visual styles only from version 6: by default a process gets the common
    controls of version 5, per Microsoft's "Enabling Visual Styles",
    learn.microsoft.com/windows/win32/controls/cookbook-overview, read 2026-10-03.
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*" />
    </dependentAssembly>
  </dependency>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        Session directories are arguments to `browserai_init` and any path is
        accepted, so their depth is unbounded by design. Without this, a profile
        tree that crosses MAX_PATH fails somewhere inside Chromium with an error
        nobody can attribute. The same file reads and writes paths under a data
        root whose depth nobody constrains, and opens Explorer at them.
      -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!--
        Per-monitor v2. A dialog that is blurry on the monitor it was not opened
        on is the first thing a person sees of this product. Corrected 2026-10-03
        (previously as written, of the task dialog): the one window this file
        still shows is the folder picker, which scales the same way.
      -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          asInvoker, never elevation. BrowserAI installs per-user to
          %LocalAppData% precisely so that nothing it does needs a UAC prompt: a
          prompt cannot be answered by a process a client or the Task Scheduler
          started, and this file edits one user's own configuration.
        -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compat.v1">
    <application>
      <!-- Windows 10 and 11. Declaring it is what makes the OS report its real
           version and not 6.2, which matters to anything that branches on
           it. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

</assembly>
