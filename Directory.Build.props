<Project>

  <!--
    Shared build settings, declared once. Nothing here is a dependency version;
    every version lives in Directory.Packages.props.

    Native compilation is configured in src/BrowserAI/BrowserAI.csproj rather
    than here, because AOT and trim analysis must be scoped per-assembly and
    never repo-wide (plan/testing.md, "What the build itself must fail on").
    A repo-wide setting is permanent and invisible: it applies to every
    assembly added afterwards, including the one it will be wrong for.
  -->

  <PropertyGroup Label="Target and language">
    <!-- Newest GA major, `-windows` suffixed: Velopack's hook callbacks are
         [SupportedOSPlatform("windows")] (plan/G-updates.md), and the suffix
         is also what keeps CA1416 quiet across the Win32 interop this product
         is largely made of. .NET 11 is not GA on 2026-08-16. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- `latestMajor`, never `preview`: README, "Versioning policy". -->
    <LangVersion>latestMajor</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Required, not cosmetic: without it Roslyn refuses to run IDE0005 (remove
      unnecessary usings) on build and fails with EnableGenerateDocumentationFile
      instead (measured 2026-08-16, SDK 10.0.302; dotnet/roslyn#41640). It also
      turns on CS1591, so anything publicly visible must be documented, which
      with TreatWarningsAsErrors is an error. That is the desired trade, not the
      price of one: an exported surface with no XML doc is a surface nobody
      described.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Warnings are errors">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      CS0162 (unreachable code) is named explicitly. This is not a tidiness
      rule: unreachable code means the compiler PROVED a branch cannot execute,
      and in this codebase that branch is usually a guard, a catch, or a
      cleanup path. The recovery path that was never going to run is the
      founding failure class of this project.

      What naming it here buys, precisely: CS0162 stays an error even if
      TreatWarningsAsErrors above is ever turned off.

      What it does NOT buy, measured 2026-08-16 on SDK 10.0.302, correcting
      what plan/build-order.md asserted: it does not survive a NoWarn. With
      `NoWarn` set to CS0162, a full rebuild of a method containing a statement
      after a `return` reported 0 warnings and 0 errors. An `.editorconfig`
      entry of `dotnet_diagnostic.CS0162.severity = error` did not survive it
      either. NoWarn wins over both, so the protection had to be something
      NoWarn cannot defeat, and it is a test:
      BuildConfigurationTests.NoBuildFileSuppressesWarnings.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0162</WarningsAsErrors>
    <!-- No NoWarn and no WarningsNotAsErrors anywhere, asserted by that test.
         A suppression belongs at the site that needs it, with its reason
         beside it, never in a shared property. -->
  </PropertyGroup>

  <PropertyGroup Label="Analyzers">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Every rule on as a build warning, which TreatWarningsAsErrors turns
         into an error. Opting a rule out is a deliberate, visible edit to
         .editorconfig carrying a written reason, never a bulk relaxation. -->
    <AnalysisMode>All</AnalysisMode>
    <!-- Makes the IDExxxx code-style rules configured in .editorconfig run on
         build rather than only inside an IDE. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Label="Never by image name">
    <!--
      The banned-API analyzer is declared HERE rather than in one project,
      because the rule it carries has no exception for test code: never match,
      count or terminate a process by image name. A project added later must be
      covered by construction rather than by somebody remembering, which is
      what putting it in this file buys. NeverByImageNameTests asserts exactly
      that: every project in the tree reads this file.

      The product adds its own bans (Console, Debug) in
      src/BrowserAI/BannedSymbols.txt. Both files carry that name deliberately;
      the analyzer reads every additional file called BannedSymbols.txt and
      merges them, which is measured rather than assumed
      (kb/windows/processes.md).

      NOTE FOR ANYONE EDITING THE COMMENT ABOVE: an XML comment cannot contain
      a double hyphen. Measured twice, 2026-08-16: one in this file makes
      MSBuild fail to load it, and `dotnet build` then reports
      `NETSDK1207: Ahead-of-time compilation is not supported for the target
      framework` from the product project, because a Directory.Build.props that
      does not load takes TargetFramework with it. Only
      `dotnet msbuild <project> -getProperty:TargetFramework` names the real
      cause.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)build\BannedSymbols.txt" />
  </ItemGroup>

  <PropertyGroup Label="Restore">
    <!-- Writes packages.lock.json beside each project. This is what makes the
         two-step resolve described in Directory.Packages.props possible, and
         it yields the cheapest drift detector there is: after a resolve, ask
         git whether any lock file changed. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Label="Never">
    <!--
      UseSystemResourceKeys strips the framework's exception message strings
      and leaves bare resource keys behind. It is a real NativeAOT size win and
      completely wrong here: this product's error text is read by a MODEL
      deciding what to do next (plan/H-model-surface.md, the error catalogue).
      `Arg_DirectoryNotFound` in place of a sentence naming the path is an
      error catalogue that has been silently emptied.

      Set explicitly to false rather than left at its default, so it cannot
      arrive later as somebody's size optimisation. The saving is kilobytes
      against a ~117 MB payload; there is no version of this trade that is
      close.
    -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

</Project>
