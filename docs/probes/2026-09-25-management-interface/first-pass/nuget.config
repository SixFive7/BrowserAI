<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Track B scratch: every package these probes restore lands under this folder, never in the user's global cache. -->
  <config>
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
