<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- b2 scratch: packages restore under this folder; the first report's folder is a read-only fallback so nothing is downloaded twice. -->
  <config>
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <fallbackPackageFolders>
    <add key="trackb" value="..\b\packages" />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
