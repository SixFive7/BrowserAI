<!--
  The CPU and memory reading's rig. Published NativeAOT, as the product is. The two
  product files below are compiled in as they stand in src/, so what is measured is the
  shipped job read and the shipped member read; the rig composes them the way
  BrowserAI.Background.BackgroundPageUsage does for one session's job.

  Kept out of the repository's build by the three files one level up, and out of
  BrowserAI.slnx by not being named there.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <RootNamespace>Usage</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\src\BrowserAI.Core\Interop\ProcessUsage.cs" Link="Product\ProcessUsage.cs" />
    <Compile Include="..\..\..\..\src\BrowserAI.Core\Interop\JobObject.cs" Link="Product\JobObject.cs" />
  </ItemGroup>
</Project>
