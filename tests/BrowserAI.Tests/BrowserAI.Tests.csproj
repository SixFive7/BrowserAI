<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MTP test applications are executables. The MTP mode of `dotnet test`
         is opted into in global.json; under it, neither the
         TestingPlatformDotnetTestSupport property nor the extra argument
         separator is needed. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>BrowserAI.Tests</RootNamespace>
    <AssemblyName>BrowserAI.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      Required by [LibraryImport] in Harness\ParentProcess.cs, which reads a
      child's real parent pid so that an interposed cmd.exe fails a test rather
      than being invisible. Same reason the product project sets it, and the
      same limit: every use is a P/Invoke declaration, never hand-written
      unsafe code.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions live in Directory.Packages.props and nowhere else. A Version
         attribute here is a failing test in BuildConfigurationTests. -->
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <!-- The upstream-review gate: four snapshots regenerated from the resolved
       payload and diffed on every build, with the diff in the failure message.
       Imported here rather than in Directory.Build.props because the gate is
       the suite, and because a shared import would run it once per project for
       one answer. -->
  <Import Project="..\..\build\UpstreamSnapshots.targets" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\BrowserAI\BrowserAI.csproj" />
    <!-- Referenced so it is built and copied beside the test host, which is
         how TestProbe finds it. Nothing here calls into its types. -->
    <ProjectReference Include="..\BrowserAI.TestProbe\BrowserAI.TestProbe.csproj" />
  </ItemGroup>

</Project>
