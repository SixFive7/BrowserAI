<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A test asset, not a product component. It exists because some of this
    product's guarantees are only true at process scope and cannot be asserted
    from inside the test host: an unhandled exception that leaves its last log
    line on disk kills whatever process runs it, and concurrent appends from
    ~100 processes are not observable from one.

    The alternative was a hidden switch or an environment-variable backdoor in
    BrowserAI itself. That would put test-only surface in the product, and the
    product's argument surface is model-facing. A separate executable keeps the
    product clean and grows with the suite: step 16 already needs a child that
    creates a message-only window suppressing WM_GETTEXT.

    It drives the REAL product code, through the real app-paths seam, with a
    scratch root. Only the root differs from production, which is what the seam
    is for.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BrowserAI.TestProbe</RootNamespace>
    <AssemblyName>BrowserAI.TestProbe</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Required by [LibraryImport] in JobProbe.cs, which reads the job's
         membership and walks a process tree from inside the process that owns
         the job. Same limit as the other two projects: every use is a P/Invoke
         declaration, never hand-written unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The native SQLite this probe loads, for the same reason the test host
      references it and with the same limits. Nothing here calls into it by
      name: the product's own [LibraryImport] declarations bind the module
      e_sqlite3, which under a publish is a symbol linked into the binary and
      under CoreCLR is a DLL that has to exist beside the exe. This probe drives
      SessionLock, and since the cutover SessionLock opens a database — so
      without this every probe mode that takes a session dies on
      `DllNotFoundException` and reports as a race that nobody won. Versions
      live in Directory.Packages.props and nowhere else.
    -->
    <PackageReference Include="SourceGear.sqlite3" />
    <ProjectReference Include="..\..\src\BrowserAI\BrowserAI.csproj" />
  </ItemGroup>

</Project>
